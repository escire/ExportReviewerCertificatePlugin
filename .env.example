# Cypress Environment Variables
# Copy this file to .env and fill in your values

# Base URL for the OJS installation
CYPRESS_BASE_URL=https://ojsdesa33.escire.site

# Admin credentials
CYPRESS_ADMIN_USER=mcruzescire
CYPRESS_ADMIN_PASSWORD=YourPasswordHere

# Reviewer credentials (for testing certificate download)
CYPRESS_REVIEWER_USER=reviewer
CYPRESS_REVIEWER_PASSWORD=ReviewerPasswordHere

# Test data - ID of a submission that has a completed review for testing
CYPRESS_TEST_SUBMISSION_ID=1
CYPRESS_JOURNAL_PATH=rdp
